{
  "name": "ai-crs-monorepo",
  "version": "1.0.0",
  "scripts": {
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:scraper": "python3 scraper/jobs_scraper.py --end-page 2",
    "dev": "concurrently -n \"FRONT,BACK,SCRAP\" -c \"cyan,green,magenta\" \"npm run dev:frontend\" \"npm run dev:backend\" \"npm run dev:scraper\"",
    "scrape": "python3 scraper/jobs_scraper.py",
    "install:all": "npm install && npm install --prefix frontend && npm install --prefix backend"
  },
  "dependencies": {
    "@google/genai": "^1.40.0",
    "@supabase/supabase-js": "^2.106.0",
    "dotenv": "^17.2.4",
    "morgan": "^1.10.1",
    "redis": "^5.12.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
